{
    "name": "nsg2-layouts",
    "version": "0.1.0",
    "description": "Broadcast graphics for the Norway Speedrunner Gathering",
    "author": {
        "name": "inkfarer",
        "email": "inkfarer@inkfarer.com",
        "url": "https://inkfarer.com"
    },
    "scripts": {
        "build:clean": "run-s clean build",
        "build": "run-p build:browser build:extension",
        "build:browser": "vite --config vite.config.browser.mjs build",
        "build:extension": "vite --config vite.config.extension.mts build",
        "build:rush": "run-p build:browser:rush build:extension:rush",
        "build:browser:rush": "vite --mode rush --config vite.config.browser.mjs build",
        "build:extension:rush": "vite --mode rush --config vite.config.extension.mts build",
        "clean": "trash node_modules/.cache && trash dashboard && trash graphics && trash shared && trash extension",
        "start": "node ../..",
        "watch": "run-p watch:*",
        "watch:browser": "vite --config vite.config.browser.mjs",
        "watch:extension": "vite --config vite.config.extension.ts",
        "schema-types": "nodecg schema-types",
        "test": "jest"
    },
    "nodecg": {
        "compatibleRange": "^1.7.0 || ^2.0.0",
        "mount": [
            {
                "directory": "flags",
                "endpoint": "flags"
            }
        ],
        "dashboardPanels": [
            {
                "name": "data-import",
                "title": "Data Import",
                "width": 2,
                "file": "data-import.html",
                "workspace": "3 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "obs-settings",
                "title": "OBS Settings",
                "width": 3,
                "file": "obs-settings.html",
                "workspace": "3 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "twitch-settings",
                "title": "Twitch Settings",
                "width": 2,
                "file": "twitch-settings.html",
                "workspace": "3 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "speedrun-playlist-control",
                "title": "Speedrun Playlist",
                "width": 2,
                "file": "speedrun-playlist-control.html",
                "workspace": "3 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "bingo",
                "title": "Bingo",
                "width": 2,
                "file": "bingo.html",
                "workspace": "3 - Setup",
                "headerColor": "#262F40"
            },
            {
                "name": "stream-tech",
                "title": "1 - Stream Tech Dashboard",
                "file": "stream-tech.html",
                "headerColor": "#262F40",
                "fullbleed": true
            },
            {
                "name": "host",
                "title": "2 - Host Dashboard",
                "file": "host.html",
                "headerColor": "#262F40",
                "fullbleed": true
            },
            {
                "name": "jep",
                "title": "4 - Game Show",
                "file": "jep.html",
                "headerColor": "#262F40",
                "fullbleed": true
            }
        ],
        "graphics": [
            {
                "file": "omnibar.html",
                "width": 1920,
                "height": 80
            },
            {
                "file": "game-layout.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "intermission.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "countdown.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "standalone-bingo.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "utility-stage-display.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "jep-buzzer-handler.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "jep-board.html",
                "width": 1920,
                "height": 1080
            },
            {
                "file": "jep-camera-overlays.html",
                "width": 1920,
                "height": 1080
            }
        ],
        "assetCategories": [
            {
                "name": "mediaBoxImages",
                "title": "Media box images",
                "allowedTypes": [
                    "jpg",
                    "jpeg",
                    "png",
                    "gif"
                ]
            },
            {
                "name": "gameLayoutMediaBoxImages",
                "title": "Media box images (Game layout only)",
                "allowedTypes": [
                    "jpg",
                    "jpeg",
                    "png",
                    "gif"
                ]
            },
            {
                "name": "intermissionMediaBoxImages",
                "title": "Media box images (Intermission only)",
                "allowedTypes": [
                    "jpg",
                    "jpeg",
                    "png",
                    "gif"
                ]
            },
            {
                "name": "jepContestantSignatures",
                "title": "Jeopardy contestant signatures",
                "allowedTypes": [
                    "png",
                    "webp"
                ]
            },
            {
                "name": "jepContestantSymbols",
                "title": "Jeopardy contestant symbols",
                "allowedTypes": [
                    "png",
                    "webp"
                ]
            }
        ],
        "soundCues": [
            {
                "name": "jep-timeout"
            },
            {
                "name": "jep-board-reveal"
            },
            {
                "name": "jep-daily-double"
            },
            {
                "name": "jep-final-category-reveal"
            }
        ]
    },
    "repository": "https://github.com/nodecg/nodecg.git",
    "devDependencies": {
        "@fortawesome/fontawesome-svg-core": "~7.3.1",
        "@fortawesome/free-brands-svg-icons": "~7.3.1",
        "@fortawesome/free-solid-svg-icons": "~7.3.1",
        "@fortawesome/vue-fontawesome": "~3.3.3",
        "@inkfarer/vite-plugin-nodecg": "2.2.0",
        "@iplsplatoon/vue-components": "3.10.0",
        "@jest/globals": "^30.4.1",
        "@nodecg/types": "^2.8.0",
        "@types/lodash": "^4.17.24",
        "@types/luxon": "^3.7.2",
        "@types/node": "^20.16.1",
        "@types/obs-studio": "^2.17.2",
        "@types/ws": "^8.18.1",
        "@vitejs/plugin-vue": "^6.0.8",
        "@vue/compiler-sfc": "^3.5.40",
        "gsap": "3.15.0",
        "jest": "^30.4.2",
        "jest-mock-extended": "^4.0.1",
        "lodash": "^4.18.1",
        "npm-run-all": "^4.1.5",
        "pinia": "~3.0.4",
        "sass": "^1.102.0",
        "trash-cli": "^7.2.0",
        "ts-jest": "^29.4.12",
        "typed-emitter": "^2.1.0",
        "typescript": "~6.0.3",
        "vite": "~8.2.0",
        "vite-plugin-checker": "~0.14.5",
        "vite-tsconfig-paths": "~6.1.1",
        "vue": "^3.5.40",
        "vue-tsc": "^2.0.29",
        "vuedraggable": "^4.1.0"
    },
    "dependencies": {
        "@floating-ui/vue": "^1.1.11",
        "axios": "^1.19.0",
        "axios-retry": "^4.5.0",
        "cookie": "~2.0.1",
        "livesplit-core": "^0.10.2",
        "luxon": "^3.7.2",
        "mitt": "^3.0.1",
        "obs-websocket-js": "^5.0.8",
        "osc": "^2.4.5",
        "p-queue": "^9.3.3",
        "uuid": "^14.0.1",
        "ws": "^8.21.1"
    },
    "jest": {
        "projects": [
            "<rootDir>/src/extension/jest.config.ts"
        ]
    }
}
