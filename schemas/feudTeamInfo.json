{
    "$schema": "http://json-schema.org/draft-07/schema",
    "definitions": {
        "team": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "score"],
            "properties": {
                "name": {
                    "type": "string"
                },
                "score": {
                    "type": "number"
                }
            }
        }
    },
    "type": "object",
    "additionalProperties": false,
    "required": ["teamA", "teamB"],
    "properties": {
        "teamA": {
            "$ref": "#/definitions/team"
        },
        "teamB": {
            "$ref": "#/definitions/team"
        }
    },
    "default": {
        "teamA": {
            "name": "Team A",
            "score": 0
        },
        "teamB": {
            "name": "Team B",
            "score": 0
        }
    }
}
