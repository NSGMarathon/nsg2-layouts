{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "state": {
            "type": "string",
            "enum": ["STOPPED", "RUNNING", "PAUSED", "FINISHED"]
        },
        "lastStartTime": {
            "type": ["string", "null"]
        },
        "rawTimeAtLastStartTime": {
            "type": "number"
        },
        "time": {
            "$ref": "defs/Duration.json"
        },
        "teamResults": {
            "type": "object",
            "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                    "state": {
                        "type": "string",
                        "enum": ["FORFEIT", "FINISHED"]
                    },
                    "time": {
                        "$ref": "defs/Duration.json"
                    }
                },
                "required": ["state", "time"]
            }
        }
    },
    "required": ["state", "time", "teamResults", "lastStartTime", "rawTimeAtLastStartTime"],
    "default": {
        "state": "STOPPED",
        "lastStartTime": null,
        "rawTimeAtLastStartTime": 0,
        "time": {
            "hours": 0,
            "minutes": 0,
            "seconds": 0,
            "milliseconds": 0,
            "rawTime": 0,
            "timestamp": 0
        },
        "teamResults": {}
    }
}
