{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "array",
    "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "score", "signatureUrl", "symbolUrl"],
        "properties": {
            "name": {
                "type": "string"
            },
            "signatureUrl": {
                "type": "string"
            },
            "symbolUrl": {
                "type": "string"
            },
            "score": {
                "type": "number"
            }
        }
    },
    "default": []
}
