{
    "$schema": "http://json-schema.org/draft-07/schema",
    "oneOf": [
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["isRunning"],
            "properties": {
                "isRunning": {
                    "const": false
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["isRunning", "returnToScene"],
            "properties": {
                "isRunning": {
                    "const": true
                },
                "returnToScene": {
                    "type": "string"
                }
            }
        }
    ],
    "default": {
        "isRunning": false
    }
}
