{
    "$schema": "http://json-schema.org/draft-07/schema",
    "definitions": {
        "cluePosition": {
            "type": "array",
            "items": {
                "type": "number"
            },
            "maxItems": 2,
            "minItems": 2
        }
    },
    "oneOf": [
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": [
                        "WAITING_FOR_CONTESTANT_INFO",
                        "STARTING_GAME",
                        "STARTING_NEXT_ROUND",
                        "FINAL_JEP_AWAITING_WAGERS",
                        "FINAL_JEP_READING_CLUE"
                    ]
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastRevealedCategoryIndex", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["REVEALING_CATEGORIES"]
                },
                "lastRevealedCategoryIndex": {
                    "type": "number"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "pickingContestantIndex", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["PICKING_CLUE"]
                },
                "pickingContestantIndex": {
                    "type": "number"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastCluePickedByIndex", "cluePosition", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["DAILY_DOUBLE_AWAITING_WAGER"]
                },
                "lastCluePickedByIndex": {
                    "type": "number"
                },
                "cluePosition": {
                    "$ref": "#/definitions/cluePosition"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastCluePickedByIndex", "guessesMadeByIndices", "buzzerEnabled", "cluePosition", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["PREPARING_CLUE"]
                },
                "lastCluePickedByIndex": {
                    "type": "number"
                },
                "guessesMadeByIndices": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "buzzerEnabled": {
                    "type": "boolean"
                },
                "cluePosition": {
                    "$ref": "#/definitions/cluePosition"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastCluePickedByIndex", "pointsWaged", "cluePosition", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["DAILY_DOUBLE_AWAITING_ANSWER"]
                },
                "lastCluePickedByIndex": {
                    "type": "number"
                },
                "pointsWaged": {
                    "type": "number"
                },
                "cluePosition": {
                    "$ref": "#/definitions/cluePosition"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastCluePickedByIndex", "guessesMadeByIndices", "buzzedByIndex", "cluePosition", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["AWAITING_ANSWER"]
                },
                "lastCluePickedByIndex": {
                    "type": "number"
                },
                "guessesMadeByIndices": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "buzzedByIndex": {
                    "type": "number"
                },
                "cluePosition": {
                    "$ref": "#/definitions/cluePosition"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "lastCluePickedByIndex", "guessesMadeByIndices", "cluePosition", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["READING_CORRECT_ANSWER"]
                },
                "lastCluePickedByIndex": {
                    "type": "number"
                },
                "guessesMadeByIndices": {
                    "type": "array",
                    "items": {
                        "type": "number"
                    }
                },
                "cluePosition": {
                    "$ref": "#/definitions/cluePosition"
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        },
        {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "finalJeopardyWagers", "lastUpdated"],
            "properties": {
                "state": {
                    "type": "string",
                    "enum": ["FINAL_JEP_REVEALING_ANSWERS", "FINAL_JEP_AWAITING_ANSWERS", "VIEW_FINAL_RESULT"]
                },
                "finalJeopardyWagers": {
                    "type": "array",
                    "items": {
                        "oneOf": [
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["scoreBeforeAnswer", "answerRevealed"],
                                "properties": {
                                    "scoreBeforeAnswer": {
                                        "type": "number"
                                    },
                                    "answerRevealed": {
                                        "const": false
                                    }
                                }
                            },
                            {
                                "type": "object",
                                "additionalProperties": false,
                                "required": ["scoreBeforeAnswer", "answerRevealed", "answerIsCorrect", "amountWagered"],
                                "properties": {
                                    "scoreBeforeAnswer": {
                                        "type": "number"
                                    },
                                    "answerRevealed": {
                                        "const": true
                                    },
                                    "answerIsCorrect": {
                                        "type": "boolean"
                                    },
                                    "amountWagered": {
                                        "type": "number"
                                    }
                                }
                            }
                        ]
                    }
                },
                "lastUpdated": {
                    "type": "string"
                }
            }
        }
    ],
    "default": {
        "state": "WAITING_FOR_CONTESTANT_INFO",
        "lastUpdated": "1970-01-01T00:00:00Z"
    }
}
