{
    "$schema": "http://json-schema.org/draft-07/schema",
    "type": "object",
    "additionalProperties": false,
    "required": ["connectionState"],
    "properties": {
        "connectionState": {
            "type": "string",
            "enum": ["NOT_CONNECTED", "CONNECTING", "CONNECTED", "ERROR"]
        }
    },
    "default": {
        "connectionState": "NOT_CONNECTED"
    }
}
